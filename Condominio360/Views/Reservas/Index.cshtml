@model ReservasIndexViewModel
@{
    ViewData["Title"] = "Reservas";
}
<div class="migas">Comunidad › Reservas</div>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Reservas de áreas comunales</h1>
    <a asp-controller="AreasComunales" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-house-gear"></i> Áreas comunales</a>
</div>

<partial name="_Alertas" />

<form asp-action="Index" method="get" class="filtros row g-2 align-items-end">
    <div class="col-6 col-md-3">
        <label class="form-label" for="estado">Estado</label>
        <select id="estado" name="estado" class="form-select">
            <option value="">Todos</option>
            @foreach (var e in Enum.GetValues<EstadoReserva>())
            {
                <option value="@e" selected="@(Model.Estado == e)">@e@(e == EstadoReserva.Solicitada ? $" ({Model.PorAprobar})" : "")</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="areaId">Área</label>
        <select id="areaId" name="areaId" class="form-select">
            <option value="">Todas</option>
            @foreach (var a in Model.Areas)
            {
                <option value="@a.Id" selected="@(Model.AreaId == a.Id)">@a.Nombre</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="desde">Desde</label>
        <input id="desde" name="desde" type="date" class="form-control" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (!Model.Reservas.Any())
{
    <div class="vacio"><p class="mb-0">No hay reservas con esos filtros.</p></div>
}
else
{
    <div class="table-responsive tabla-caja">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th><th>Horario</th><th>Área</th><th>Residente</th>
                    <th>Morosidad</th><th>Estado</th><th>Resuelta por</th><th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reservas)
                {
                    var unidadId = r.Residente?.UnidadId ?? 0;
                    var tieneClasificacion = Model.ClasificacionPorUnidad.TryGetValue(unidadId, out var clasificacion);
                    var bloqueada = tieneClasificacion && !Condominio360.Services.CobranzaService.PuedeReservar(clasificacion);
                    var pasada = r.Fecha.Date < DateTime.Today;
                    <tr>
                        <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">@r.HoraInicio.ToString("HH:mm") – @r.HoraFin.ToString("HH:mm")</td>
                        <td>@r.Area?.Nombre</td>
                        <td>@r.Residente?.NombreCompleto <span class="placa">@r.Residente?.Unidad?.Codigo</span></td>
                        <td>
                            @if (tieneClasificacion)
                            {
                                <span class="@Formato.ClaseClasificacion(clasificacion)">@Formato.Texto(clasificacion)</span>
                            }
                            else { <span class="text-secondary">—</span> }
                        </td>
                        <td><span class="@Formato.ClaseEstado(r.Estado)">@r.Estado</span></td>
                        <td>@(r.AprobadaPorUsuario?.NombreCompleto ?? "—")</td>
                        <td class="text-end text-nowrap">
                            @if (r.Estado == EstadoReserva.Solicitada)
                            {
                                <form asp-action="Aprobar" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(bloqueada || pasada)"
                                            title="@(pasada ? "La fecha ya pasó: recházela" : bloqueada ? "La unidad es morosa: no puede reservar" : "Aprobar")">
                                        <i class="bi bi-check-lg"></i> Aprobar
                                    </button>
                                </form>
                                <form asp-action="Rechazar" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Rechazar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="texto-pequeno mt-2">
        Al aprobar se vuelve a verificar en el servidor que el horario no se cruce con otra reserva aprobada y que la unidad
        no esté clasificada como Moroso o Moroso crítico.
    </p>
}
