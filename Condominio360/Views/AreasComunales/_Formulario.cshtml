@model AreaComunalFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-sm-8">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Salón comunal" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="Capacidad" class="form-label"></label>
        <input asp-for="Capacidad" class="form-control" type="number" min="1" max="500" />
        <span asp-validation-for="Capacidad" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="2" maxlength="250"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="HoraApertura" class="form-label"></label>
        <input asp-for="HoraApertura" class="form-control" type="time" asp-format="{0:HH:mm}" />
        <span asp-validation-for="HoraApertura" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="HoraCierre" class="form-label"></label>
        <input asp-for="HoraCierre" class="form-control" type="time" asp-format="{0:HH:mm}" />
        <span asp-validation-for="HoraCierre" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="CostoUso" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="CostoUso" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <span asp-validation-for="CostoUso" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="Activa" class="form-check-input" />
            <label asp-for="Activa" class="form-check-label"></label>
        </div>
    </div>
</div>
