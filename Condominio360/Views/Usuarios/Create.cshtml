@model UsuarioFormViewModel
@{
    ViewData["Title"] = "Crear usuario";
}
<div class="migas"><a asp-action="Index">Usuarios</a> › Crear usuario</div>
<h1 class="h3 mb-3">Crear usuario</h1>
<div class="tarjeta-form">
    <form asp-action="Create" method="post">
        <partial name="_Formulario" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Crear usuario</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cascada.js" asp-append-version="true"></script>
    <script src="~/js/usuario-form.js" asp-append-version="true"></script>
}
