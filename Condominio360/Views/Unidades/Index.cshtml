@model IEnumerable<Unidad>
@{
    ViewData["Title"] = "Unidades";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Unidades</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Registrar unidad</a>
</div>

<partial name="_Alertas" />

@if (!Model.Any())
{
    <div class="vacio">
        <p class="mb-2">Aún no hay unidades registradas.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm">Registrar la primera unidad</a>
    </div>
}
else
{
    <div class="table-responsive tabla-caja">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Unidad</th>
                    <th>Piso</th>
                    <th>Tipo</th>
                    <th class="text-end">Área</th>
                    <th class="text-end">Alícuota</th>
                    <th class="text-center">Residentes</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><span class="placa">@u.Codigo</span></td>
                        <td>@u.Piso</td>
                        <td>@u.Tipo</td>
                        <td class="text-end">@u.AreaM2.ToString("0.##") m²</td>
                        <td class="text-end">@u.Alicuota.ToString("C")</td>
                        <td class="text-center">@u.Residentes.Count</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Ver"><i class="bi bi-eye"></i><span class="visually-hidden">Ver</span></a>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span></a>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i><span class="visually-hidden">Eliminar</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
