@{
    ViewData["Title"] = "Cuenta sin unidad";
}
<div class="text-center py-5">
    <i class="bi bi-link-45deg display-4 text-secondary"></i>
    <h1 class="h3 mt-3">Tu cuenta no está vinculada a un residente</h1>
    <p class="text-secondary mb-4">
        Para consultar tu estado de cuenta, reportar pagos, reservar áreas comunales o autorizar visitas,
        la administración debe vincular tu usuario con tu registro de residente.
    </p>
    <a asp-controller="Panel" asp-action="Index" class="btn btn-outline-primary">Volver al inicio</a>
</div>
