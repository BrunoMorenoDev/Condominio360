@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var autenticado = User.Identity?.IsAuthenticated == true;
    var nombre = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name;
    var inicio = autenticado ? "Panel" : "Home";
    string Activo(string c) => controlador == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Condominio360</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark barra">
            <div class="container">
                <a class="navbar-brand marca" asp-controller="@inicio" asp-action="Index">
                    <span class="marca-placa">360</span> Condominio360
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    @if (autenticado)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @Activo("Panel")" asp-controller="Panel" asp-action="Index"><i class="bi bi-speedometer2"></i> Panel</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Unidades")" asp-controller="Unidades" asp-action="Index"><i class="bi bi-buildings"></i> Unidades</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Residentes")" asp-controller="Residentes" asp-action="Index"><i class="bi bi-people"></i> Residentes</a></li>
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="usuario-actual"><i class="bi bi-person-circle"></i> @nombre</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-light">Cerrar sesión</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="ms-auto">
                            <a class="btn btn-sm btn-laton" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="container">Condominio360 · Proyecto de Ingeniería Web · ASP.NET Core MVC</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
