@model IEnumerable<Residente>
@{
    ViewData["Title"] = "Residentes";
    var buscar = ViewData["Buscar"] as string;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Residentes</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Registrar residente</a>
</div>

<partial name="_Alertas" />

<form asp-action="Index" method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <label for="buscar" class="visually-hidden">Buscar residente</label>
        <input id="buscar" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre, apellido o cédula" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="vacio">
        @if (string.IsNullOrWhiteSpace(buscar))
        {
            <p class="mb-2">Aún no hay residentes registrados.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">Registrar el primer residente</a>
        }
        else
        {
            <p class="mb-0">Ningún residente coincide con “@buscar”.</p>
        }
    </div>
}
else
{
    <div class="table-responsive tabla-caja">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Residente</th>
                    <th>Cédula</th>
                    <th>Unidad</th>
                    <th>Tipo</th>
                    <th>Correo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Apellidos, @r.Nombres</td>
                        <td>@r.Cedula</td>
                        <td><span class="placa">@r.Unidad?.Codigo</span></td>
                        <td>@r.Tipo</td>
                        <td>@r.Correo</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="Ver"><i class="bi bi-eye"></i><span class="visually-hidden">Ver</span></a>
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span></a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i><span class="visually-hidden">Eliminar</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
