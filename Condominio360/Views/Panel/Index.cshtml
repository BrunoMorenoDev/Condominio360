@model PanelViewModel
@{
    ViewData["Title"] = "Panel";
}
<partial name="_Alertas" />

<div class="mb-4">
    <h1 class="h3 mb-1">Hola, @Model.NombreUsuario</h1>
    <p class="text-secondary mb-0">Así está el condominio hoy, @DateTime.Today.ToString("dd/MM/yyyy").</p>
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="indicador">
            <span class="indicador-valor">@Model.UnidadesActivas <small class="fs-6 text-secondary">/ @Model.TotalUnidades</small></span>
            <span class="indicador-texto">unidades activas</span>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="indicador">
            <span class="indicador-valor">@Model.TotalResidentes</span>
            <span class="indicador-texto">residentes registrados</span>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="indicador indicador-laton">
            <span class="indicador-valor">@Model.AlicuotaMensualTotal.ToString("C")</span>
            <span class="indicador-texto">alícuotas por mes (unidades activas)</span>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="text-decoration-none" asp-controller="Pagos" asp-action="Index" asp-route-estado="PorVerificar">
            <div class="indicador indicador-laton">
                <span class="indicador-valor">@Model.PagosPorVerificar</span>
                <span class="indicador-texto">pagos por verificar <i class="bi bi-arrow-right"></i></span>
            </div>
        </a>
    </div>
</div>

<h2 class="h5 mt-4 mb-3">Cobranza</h2>
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="kpi">
            <div class="kpi-etiqueta">Índice de morosidad</div>
            <div class="kpi-valor">@Model.IndiceMorosidad.ToString("0.#") %</div>
            <div class="kpi-nota">unidades con al menos 1 cuota vencida</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="kpi">
            <div class="kpi-etiqueta">Cartera vencida</div>
            <div class="kpi-valor negativo">@Model.CarteraVencida.ToString("C")</div>
            <div class="kpi-nota">capital + recargos de cuotas vencidas</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="kpi">
            <div class="kpi-etiqueta">Recaudación @Model.PeriodoRecaudacion</div>
            <div class="kpi-valor">@Model.TasaRecaudacion.ToString("0.#") %</div>
            <div class="kpi-nota">cobrado / emitido del periodo</div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Morosidad" asp-action="Index" class="btn btn-primary"><i class="bi bi-graph-down-arrow"></i> Reporte de morosidad</a>
    <a asp-controller="Pagos" asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-cash"></i> Registrar pago</a>
    <a asp-controller="Cuotas" asp-action="Generar" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Generar cuotas</a>
    <a asp-controller="Unidades" asp-action="Create" class="btn btn-outline-secondary"><i class="bi bi-plus-lg"></i> Registrar unidad</a>
    <a asp-controller="Residentes" asp-action="Create" class="btn btn-outline-secondary"><i class="bi bi-person-plus"></i> Registrar residente</a>
</div>
