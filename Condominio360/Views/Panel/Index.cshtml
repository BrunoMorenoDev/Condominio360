@model PanelViewModel
@{
    ViewData["Title"] = "Panel";
}
<partial name="_Alertas" />

<div class="mb-4">
    <h1 class="h3 mb-1">Hola, @Model.NombreUsuario</h1>
    <p class="text-secondary mb-0">Así está el condominio hoy.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="indicador">
            <span class="indicador-valor">@Model.TotalUnidades</span>
            <span class="indicador-texto">unidades registradas</span>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="indicador">
            <span class="indicador-valor">@Model.UnidadesOcupadas</span>
            <span class="indicador-texto">unidades con residentes</span>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="indicador">
            <span class="indicador-valor">@Model.TotalResidentes</span>
            <span class="indicador-texto">residentes (@Model.Propietarios propietarios, @Model.Arrendatarios arrendatarios)</span>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="indicador indicador-laton">
            <span class="indicador-valor">@Model.AlicuotaMensualTotal.ToString("C")</span>
            <span class="indicador-texto">alícuotas por mes</span>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Unidades" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Registrar unidad</a>
    <a asp-controller="Residentes" asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-person-plus"></i> Registrar residente</a>
</div>
