<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Condominio360</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Proveedor de EF Core para PostgreSQL (Supabase) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Secretos locales: nunca se copian a la carpeta de publicación (Azure usa variables de entorno) -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
